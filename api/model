from django.db import models

class ImeiTest(models.Model){
    imei = model.CharField(max_len=10, null=True, blank=True)

    def __str__(self):
        return self.imei
}

class DeviceTest(ImeiTest, models.Model){
    imei = model.ForeignKey(ImeiTest, on_delete=model.CASCADE)
}


class Device(models.Model):
    name = models.CharFiled(max_length=25)
    model = models.CharFiled(max_length=12)

    def __str__(self):
        return self.name

class Imei(models.Model):
    device_id = models.ForeignKey(Device, on_delete= models.CASCADE)
    imei = models.PositiveInteger(max_length=12)

    def __str__(self):
        return str(self.imei)
